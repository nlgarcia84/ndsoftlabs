---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/home/Hero.astro";
import Services from "../components/home/Services.astro";
import CTA from "../components/home/CTA.astro";
import Projects from "../components/home/Projects.astro";
import Section from "../components/ui/Section.astro";
import ContactForm from "../components/ContactForm.astro";
import Team from "../components/Team.astro";
import Button from "../components/ui/Button.astro";
---
<MainLayout
	title="ND Soft Labs"
	description="ND Soft Labs - Tu socio en soluciones de software"
>
	<Hero />
	<Services id="servicios" />
	<CTA />
	<Team id="nosotros" />
	<div class="mt-10 flex justify-center px-4">
		<Button class="text-base sm:text-xl" variant="secondary" href="/nosotros">
			Conoce más sobre ND Soft Labs
		</Button>
	</div>
	<Projects id="proyectos" />
	<Section id="contacto" title="Contacto">
		<ContactForm />
	</Section>
</MainLayout>

---
import MainLayout from "../../layouts/MainLayout.astro";

export function getStaticPaths() {
  const projects = {
    "proyecto-1": { title: "Proyecto 1", description: "Descripción breve del primer proyecto." },
    "proyecto-2": { title: "Proyecto 2", description: "Descripción breve del segundo proyecto." },
    "proyecto-3": { title: "Proyecto 3", description: "Descripción breve del tercer proyecto." },
  };

  return Object.entries(projects).map(([slug, project]) => ({ params: { slug }, props: { project } }));
}

const { project } = Astro.props;
---
<MainLayout title={project.title} description={project.description}>
  <article class="mx-auto w-full max-w-3xl px-6 py-16 sm:py-24">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-5xl">{project.title}</h1>
    <p class="mt-6 text-base leading-relaxed text-gray-600">{project.description}</p>
  </article>
</MainLayout>

---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";

const projects = [
  { slug: "proyecto-1", title: "Proyecto 1", description: "Descripción breve del primer proyecto." },
  { slug: "proyecto-2", title: "Proyecto 2", description: "Descripción breve del segundo proyecto." },
  { slug: "proyecto-3", title: "Proyecto 3", description: "Descripción breve del tercer proyecto." },
];
---
<MainLayout title="Proyectos" description="Proyectos de ND Soft Labs">
  <section class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-24">
    <h1 class="mb-10 text-3xl font-semibold tracking-tight text-foreground sm:text-5xl">Proyectos</h1>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard {...project} href={`/proyectos/${project.slug}`} />)}
    </div>
  </section>
</MainLayout>

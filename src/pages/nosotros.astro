---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/ui/Section.astro";
import { team } from "../data/team";
---
<MainLayout title="Nosotros" description="Conoce ND Soft Labs">
	<Section>
		<h1 class="text-center text-3xl font-semibold tracking-tight text-foreground sm:text-5xl">
			Nosotros
		</h1>
		<p class="mx-auto mt-4 max-w-xl text-center text-sm text-gray-600 sm:text-base">
			Conocé al equipo detrás de ND Soft Labs.
		</p>
	</Section>

	<Section title="Nuestro equipo">
		<ul class="grid gap-6 sm:grid-cols-2">
			{team.map((member) => (
				<li
					data-card
					class="flex flex-col items-center rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center transition-all duration-200 hover:border-gray-300 hover:bg-gray-100"
				>
					{member.photo ? (
						<img
							src={member.photo}
							alt={member.name}
							class="mb-5 h-28 w-28 rounded-full object-cover"
						/>
					) : (
						<div class="mb-5 flex h-28 w-28 items-center justify-center rounded-full bg-gradient-to-br from-accent to-pink text-xl font-semibold text-background">
							{member.name.split(" ").map((n) => n[0]).join("")}
						</div>
					)}
					<h3 class="text-base font-semibold text-foreground">{member.name}</h3>
					<p class="mt-1 text-sm font-medium text-accent">{member.role}</p>
					{member.description && (
						<p class="mt-3 text-sm leading-relaxed text-gray-600">{member.description}</p>
					)}
				</li>
			))}
		</ul>
	</Section>
</MainLayout>

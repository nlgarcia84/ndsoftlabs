---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props as Props;
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body class="font-sans bg-background text-foreground min-h-screen flex flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<ScrollToTop />

		<script>
			import gsap from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";

			gsap.registerPlugin(ScrollTrigger);

			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (!reduce) {
				const heroSection = document.querySelector<HTMLElement>("[data-hero-section]");
				const heroWords = gsap.utils.toArray<HTMLElement>("[data-word]");

				if (heroSection && heroWords.length) {
					gsap.from(heroWords, {
						opacity: 0,
						scale: 0.4,
						transformOrigin: "50% 50%",
						ease: "none",
						stagger: 0.2,
						scrollTrigger: {
							trigger: heroSection,
							start: "top 64px",
							end: "+=120%",
							scrub: 1,
							pin: true,
						},
					});
				}

				gsap.utils.toArray<HTMLElement>("[data-animate]").forEach((section) => {
					gsap.from(section, {
						autoAlpha: 0,
						y: 40,
						duration: 0.8,
						ease: "power2.out",
						scrollTrigger: {
							trigger: section,
							start: "top 85%",
						},
					});
				});

				const cards = gsap.utils.toArray<HTMLElement>("[data-card]");
				if (cards.length) {
					gsap.set(cards, { autoAlpha: 0, y: 30 });
					ScrollTrigger.batch(cards, {
						start: "top 85%",
						onEnter: (batch) =>
							gsap.to(batch, {
								autoAlpha: 1,
								y: 0,
								duration: 0.6,
								ease: "power2.out",
								stagger: 0.12,
								overwrite: true,
							}),
					});
				}

				const indicator = document.querySelector<HTMLElement>("[data-scroll-indicator]");
				if (indicator) {
					gsap.to(indicator, {
						y: 10,
						duration: 0.9,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					});
				}
			}
		</script>
	</body>
</html>

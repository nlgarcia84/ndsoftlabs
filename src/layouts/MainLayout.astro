---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props as Props;
---
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
		<script is:inline>document.documentElement.classList.add("js");</script>
	</head>
	<body class="font-sans bg-background text-foreground min-h-screen flex flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<ScrollToTop />

		<script>
			import gsap from "gsap";
			import { ScrollTrigger } from "gsap/ScrollTrigger";

			gsap.registerPlugin(ScrollTrigger);

			ScrollTrigger.config({
				ignoreMobileResize: true,
				autoRefreshEvents: "visibilitychange,DOMContentLoaded",
			});

			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (!reduce) {
				const heroSection = document.querySelector<HTMLElement>("[data-hero-section]");
				const heroLines = gsap.utils.toArray<HTMLElement>(".hero-line");
				const heroDescription = document.querySelector<HTMLElement>(".hero-description");
				const heroActions = document.querySelector<HTMLElement>(".hero-actions");
				const heroOrbs = gsap.utils.toArray<HTMLElement>("[data-hero-orb]");

				if (heroSection && heroLines.length) {
					const tl = gsap.timeline({
						defaults: {
							ease: "power3.out",
						},
					});

					tl.from(heroLines, {
						y: 35,
						opacity: 0,
						duration: 0.8,
						stagger: 0.12,
					})
						.from(
							heroDescription,
							{
								y: 20,
								opacity: 0,
								duration: 0.6,
							},
							"-=0.35",
						)
						.from(
							heroActions,
							{
								y: 15,
								opacity: 0,
								duration: 0.5,
							},
							"-=0.25",
						);
				}

				gsap.to(".gradient-text", {
					backgroundPosition: "200% center",
					duration: 3,
					ease: "none",
					repeat: -1,
				});

				if (heroOrbs.length) {
					window.addEventListener("pointermove", (event) => {
						const x = ((event.clientX / window.innerWidth) - 0.5) * 12;
						const y = ((event.clientY / window.innerHeight) - 0.5) * 12;

						gsap.to(heroOrbs, {
							x,
							y,
							duration: 1.2,
							ease: "power3.out",
							overwrite: true,
							stagger: 0.08,
						});
					});
				}

				gsap.utils.toArray<HTMLElement>("[data-animate]").forEach((section) => {
					gsap.fromTo(
						section,
						{ autoAlpha: 0, y: 40 },
						{
							autoAlpha: 1,
							y: 0,
							duration: 0.8,
							ease: "power2.out",
							scrollTrigger: {
								trigger: section,
								start: "top 85%",
							},
						},
					);
				});

				const cards = gsap.utils.toArray<HTMLElement>("[data-card]");
				if (cards.length) {
					gsap.set(cards, { autoAlpha: 0, y: 30 });
					ScrollTrigger.batch(cards, {
						start: "top 85%",
						onEnter: (batch) =>
							gsap.to(batch, {
								autoAlpha: 1,
								y: 0,
								duration: 0.6,
								ease: "power2.out",
								stagger: 0.12,
								overwrite: true,
							}),
					});
				}

				const indicator = document.querySelector<HTMLElement>("[data-scroll-indicator]");
				if (indicator) {
					gsap.to(indicator, {
						y: 10,
						duration: 0.9,
						repeat: -1,
						yoyo: true,
						ease: "sine.inOut",
					});
				}
			}

			ScrollTrigger.refresh();
		</script>
	</body>
</html>

---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import Section from "./ui/Section.astro";
import { team } from "../data/team";

interface Props {
	id?: string;
}

const { id } = Astro.props;
---
<Section id={id} title="Nuestro equipo">
	<ul class="grid gap-6 sm:grid-cols-2">
		{team.map((member) => (
			<li
				data-card
				class="flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-8 text-center backdrop-blur-md transition-all duration-200 hover:border-white/20 hover:bg-white/10"
			>
				{member.photo ? (
					<Image
						src={member.photo}
						alt={member.name}
						width={112}
						height={112}
						loading="lazy"
						class="mb-5 h-28 w-28 rounded-full object-cover grayscale"
					/>
				) : (
					<div class="mb-5 flex h-28 w-28 items-center justify-center rounded-full bg-gradient-to-br from-accent to-pink text-xl font-semibold text-background">
						{member.name.split(" ").map((n) => n[0]).join("")}
					</div>
				)}
				<h3 class="text-lg font-semibold text-foreground sm:text-xl">{member.name}</h3>
				<p class="mt-1 text-base font-medium text-cyan">{member.role}</p>
				{member.description && (
					<p class="mt-3 text-base leading-relaxed text-gray-600">{member.description}</p>
				)}
			</li>
		))}
	</ul>
</Section>

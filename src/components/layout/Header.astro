---
import { navigation } from "../../data/navigation";
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 bg-background/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a
			href="/"
			aria-label="ND Soft Labs, inicio"
			class="text-lg font-semibold tracking-tight transition-opacity hover:opacity-80"
		>
			<span class="gradient-text">ND</span> Soft Labs
		</a>

		<nav aria-label="Navegación principal" class="hidden lg:block">
			<ul class="flex items-center gap-1 sm:gap-2">
				{navigation.map((item) => (
					<li>
						<a
							href={item.href}
							class="rounded-full px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-foreground"
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<button
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Abrir menú"
			class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:bg-gray-100 hover:text-foreground lg:hidden"
		>
			<svg
				data-menu-icon-open
				xmlns="http://www.w3.org/2000/svg"
				class="h-5 w-5"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg
				data-menu-icon-close
				xmlns="http://www.w3.org/2000/svg"
				class="hidden h-5 w-5"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	<div
		id="mobile-menu"
		data-menu-panel
		class="absolute left-0 right-0 top-full overflow-hidden border-t border-gray-200 bg-background/80 backdrop-blur-md lg:hidden"
	>
		<nav aria-label="Navegación móvil" class="mx-auto max-w-6xl px-6 py-4">
			<ul class="flex flex-col gap-1">
				{navigation.map((item, index) => (
					<li style={`transition-delay: ${index * 60}ms`}>
						<a
							href={item.href}
							class="block rounded-lg px-3 py-2.5 text-base font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-foreground"
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>

<style>
	[data-menu-panel] {
		max-height: 0;
		opacity: 0;
		visibility: hidden;
		transition:
			max-height 0.35s ease-in-out,
			opacity 0.35s ease-in-out,
			visibility 0s linear 0.35s;
	}

	[data-menu-panel].is-open {
		max-height: 24rem;
		opacity: 1;
		visibility: visible;
		transition:
			max-height 0.35s ease-in-out,
			opacity 0.35s ease-in-out;
	}

	[data-menu-panel] li {
		opacity: 0;
		transform: translateY(-6px);
		transition:
			opacity 0.3s ease-in-out,
			transform 0.3s ease-in-out;
	}

	[data-menu-panel].is-open li {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	const toggle = document.querySelector("[data-menu-toggle]");
	const panel = document.querySelector("[data-menu-panel]");
	const iconOpen = document.querySelector("[data-menu-icon-open]");
	const iconClose = document.querySelector("[data-menu-icon-close]");

	if (toggle && panel) {
		const setOpen = (open) => {
			panel.classList.toggle("is-open", open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
			if (iconOpen) iconOpen.classList.toggle("hidden", open);
			if (iconClose) iconClose.classList.toggle("hidden", !open);
		};

		toggle.addEventListener("click", () => {
			setOpen(!panel.classList.contains("is-open"));
		});

		panel.addEventListener("click", (event) => {
			if (event.target.closest("a")) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});
	}
</script>

---
import Section from "../ui/Section.astro";
import { Icon } from "astro-icon/components";
import { services } from "../../data/services";
---
<Section title="Servicios">
	<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{services.map((service) => (
			<li class="group rounded-2xl border border-gray-200 bg-gray-50 p-6 text-center transition-all duration-200 hover:border-gray-300 hover:bg-gray-100">
				<Icon
					name={service.icon}
					class="mx-auto mb-4 h-8 w-8 text-gray-400 transition-colors group-hover:text-foreground"
				/>
				<h3 class="mb-2 text-base font-semibold text-foreground">
					{service.title}
				</h3>
				<p class="text-sm leading-relaxed text-gray-600">
					{service.description}
				</p>
			</li>
		))}
	</ul>
</Section>

---
import Section from "../ui/Section.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

interface Props {
	id?: string;
	title?: string;
	headingLevel?: "h1" | "h2" | "h3";
}

const { id, title = "Servicios", headingLevel } = Astro.props;
const services = await getCollection("services");
---
<div data-services-track class="relative lg:h-[400vh]">
	<Section
		id={id}
		title={title}
		headingLevel={headingLevel}
		animate={false}
		padded={false}
		class="flex min-h-[calc(100svh-5rem)] flex-col justify-center py-16 sm:py-20 lg:sticky lg:top-20"
	>
		<canvas
			slot="background"
			data-services-canvas
			class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-40"
			aria-hidden="true"
		></canvas>
		<div
			slot="background"
			class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-b from-background via-background/70 to-background"
			aria-hidden="true"
		></div>

		<ul data-services class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{services.map(({ id: slug, data: service }) => (
				<li data-service-card>
					<a
						href={`/servicios/${slug}`}
						class="service-card group flex h-full flex-col rounded-2xl border border-white/10 bg-white/5 p-6 text-center backdrop-blur-md transition-all duration-500 ease-out hover:border-white/20 hover:bg-white/10"
					>
						<div class={`mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-linear-to-br ${service.accent} text-white transition-transform duration-200 group-hover:scale-105`}>
							<Icon name={service.icon} class="h-6 w-6" />
						</div>
						<h3 class="mb-2 text-2xl font-semibold text-gray-900">{service.title}</h3>
						<p class="text-xl leading-relaxed text-gray-600">{service.shortDescription}</p>
					</a>
				</li>
			))}
		</ul>
	</Section>
</div>

<style>
	.service-card {
		isolation: isolate;
		overflow: hidden;
		position: relative;
		transition:
			background-color 0.5s ease-out,
			border-color 0.5s ease-out,
			box-shadow 0.5s ease-out;
	}

	.service-card::before {
		background: radial-gradient(circle at 50% 0%, rgba(0, 112, 243, 0.22), transparent 62%);
		content: "";
		inset: 0;
		opacity: 0;
		pointer-events: none;
		position: absolute;
		transition: opacity 0.5s ease-out;
		z-index: -1;
	}

	.service-card:hover {
		box-shadow: 0 0 36px rgba(0, 112, 243, 0.2);
	}

	.service-card:hover::before {
		opacity: 1;
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const track = document.querySelector("[data-services-track]");
	const cards = gsap.utils.toArray<HTMLElement>("[data-service-card]");
	const canvas = document.querySelector<HTMLCanvasElement>("[data-services-canvas]");

	const frameModules = import.meta.glob("../../assets/3dvideo-frames/*.jpg", {
		eager: true,
		query: "?url",
		import: "default",
	}) as Record<string, string>;

	const frameUrls = Object.keys(frameModules)
		.sort()
		.map((key) => frameModules[key]);

	const images = frameUrls.map((url) => {
		const img = new Image();
		img.decoding = "async";
		img.src = url;
		return img;
	});

	const total = images.length;
	const ctx = canvas?.getContext("2d") ?? null;
	let currentFrame = -1;

	const drawFrame = (index: number) => {
		if (!canvas || !ctx || total === 0) return;
		const clamped = Math.max(0, Math.min(total - 1, Math.round(index)));
		if (clamped === currentFrame) return;
		const img = images[clamped];
		if (!img || !img.complete || img.naturalWidth === 0) return;
		currentFrame = clamped;

		const cw = canvas.width;
		const ch = canvas.height;
		const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
		const w = img.naturalWidth * scale;
		const h = img.naturalHeight * scale;
		ctx.clearRect(0, 0, cw, ch);
		ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
	};

	const resizeCanvas = () => {
		if (!canvas) return;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const rect = canvas.getBoundingClientRect();
		canvas.width = Math.max(1, Math.round(rect.width * dpr));
		canvas.height = Math.max(1, Math.round(rect.height * dpr));
		const previous = currentFrame;
		currentFrame = -1;
		drawFrame(previous < 0 ? 0 : previous);
	};

	if (canvas && total) {
		resizeCanvas();
		window.addEventListener("resize", resizeCanvas);
		const first = images[0];
		if (first) first.addEventListener("load", () => drawFrame(0), { once: true });
	}

	if (!reduce && track && cards.length) {
		const stage = track.querySelector<HTMLElement>("section");

		const getCenterOffset = (card: HTMLElement) => {
			const stageRect = stage?.getBoundingClientRect() ?? track.getBoundingClientRect();
			const cardRect = card.getBoundingClientRect();
			return {
				x: stageRect.left + stageRect.width / 2 - (cardRect.left + cardRect.width / 2),
				y: stageRect.top + stageRect.height / 2 - (cardRect.top + cardRect.height / 2),
			};
		};

		cards.forEach((card) => {
			const offset = getCenterOffset(card);
			gsap.fromTo(
				card,
				{ autoAlpha: 0, x: offset.x, y: offset.y, scale: 0.65 },
				{
					autoAlpha: 1,
					x: 0,
					y: 0,
					scale: 1,
					ease: "none",
					scrollTrigger: {
						trigger: track,
							start: "top top",
							end: "+=100%",
							scrub: 1.4,
						invalidateOnRefresh: true,
					},
				},
			);
		});

		ScrollTrigger.create({
			trigger: track,
			start: "top 80px",
			end: "bottom bottom",
			scrub: 1,
			invalidateOnRefresh: true,
			onUpdate: (self) => drawFrame(self.progress * (total - 1)),
		});

		ScrollTrigger.refresh();
	}
</script>

---
import { team } from "../../data/team";
---
<section class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-24">
	<h2 class="mb-10 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
		Equipo
	</h2>
	<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{team.map((member) => (
			<li class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-background p-6">
				<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-accent to-pink text-sm font-semibold text-background">
					{member.name.split(" ").map((n) => n[0]).join("")}
				</div>
				<div>
					<h3 class="text-base font-semibold text-foreground">{member.name}</h3>
					<p class="text-sm text-gray-600">{member.role}</p>
				</div>
			</li>
		))}
	</ul>
</section>

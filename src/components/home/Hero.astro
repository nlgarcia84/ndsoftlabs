---
import heroVideo from "../../assets/hero_video.mp4";
---
<section class="relative flex min-h-[calc(100svh-4rem)] items-center overflow-hidden">
	<video
		class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover blur-[2px]"
		src={heroVideo}
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		aria-hidden="true"
	></video>

	<div
		class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-background/95 via-background/85 to-background"
		aria-hidden="true"
	></div>

	<div class="mx-auto w-full max-w-6xl px-6 py-16 text-center sm:py-24">
		<h1 class="mx-auto max-w-5xl text-balance text-5xl font-semibold tracking-tight text-foreground sm:text-8xl">
			Construimos <span class="gradient-text">productos digitales</span> con propósito.
		</h1>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
			<slot />
		</div>
	</div>
</section>

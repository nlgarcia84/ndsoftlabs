---
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
---
<Section padded={false} class="pb-20 sm:pb-32">
	<div class="relative overflow-hidden rounded-3xl border border-gray-200 bg-gray-50 px-8 py-16 text-center sm:px-16">
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_80%_at_50%_0%,rgba(0,223,216,0.16),transparent_70%)]"
			aria-hidden="true"
		></div>
		<div class="relative">
			<h2 class="mx-auto max-w-2xl text-balance text-2xl font-semibold tracking-tight text-foreground sm:text-4xl">
				¿Tu web podría conseguir más clientes?
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-sm text-gray-600 sm:text-base">
				Analizamos tu web gratuitamente y te mostramos qué cambiaríamos para mejorarla.
			</p>
			<div class="mt-8 flex justify-center">
				<Button href="/#contacto">Quiero mi auditoría gratuita</Button>
			</div>
		</div>
	</div>
</Section>

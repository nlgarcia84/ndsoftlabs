---
interface Props {
  id?: string;
  title?: string;
  class?: string;
  padded?: boolean;
  headingLevel?: "h1" | "h2" | "h3";
  animate?: boolean;
}

const {
  id,
  title,
  class: className = "",
  padded = true,
  headingLevel = "h2",
  animate = true,
} = Astro.props;

const Heading = headingLevel;
const hasBackground = Astro.slots.has("background");
---
<section
  id={id}
  data-animate={animate ? "" : undefined}
  class={`relative ${hasBackground ? "isolate overflow-hidden" : ""} ${padded ? "py-20 sm:py-32" : ""} ${className}`}
>
  {hasBackground && <slot name="background" />}
  <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6">
    {title && (
      <div class="mb-12 flex flex-col items-center gap-5 sm:mb-20">
        <span class="h-1 w-12 rounded-full bg-gradient-to-r from-accent via-cyan to-pink"></span>
        <Heading class="bg-gradient-to-b from-foreground to-gray-500 bg-clip-text text-center text-2xl font-semibold tracking-tight text-transparent sm:text-5xl">
          {title}
        </Heading>
      </div>
    )}
    <slot />
  </div>
</section>

---
interface Props {
  id?: string;
  title?: string;
  class?: string;
  padded?: boolean;
}

const { id, title, class: className = "", padded = true } = Astro.props;
---
<section id={id} class={`${padded ? "py-16 sm:py-24" : ""} ${className}`}>
  <div class="mx-auto w-full max-w-6xl px-6">
    {title && (
      <h2 class="mb-12 text-center text-2xl font-semibold tracking-tight text-foreground sm:text-4xl">
        {title}
      </h2>
    )}
    <slot />
  </div>
</section>
